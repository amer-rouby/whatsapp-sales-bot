# Copy to .env (never commit .env). All names are prefixed SALESBOT_ on purpose.

# Database (defaults match docker-compose.yml)
SALESBOT_DB_URL=jdbc:postgresql://localhost:5442/salesbot
SALESBOT_DB_USERNAME=salesbot
SALESBOT_DB_PASSWORD=salesbot

# WhatsApp Cloud API (Meta app dashboard)
SALESBOT_WA_VERIFY_TOKEN=choose-any-random-string
SALESBOT_WA_APP_SECRET=
SALESBOT_WA_VERIFY_SIGNATURE=true
SALESBOT_WA_ACCESS_TOKEN=
SALESBOT_WA_API_VERSION=v25.0
# log = print replies locally, cloud = really send through WhatsApp
SALESBOT_WA_SENDER=log

# AI provider: echo (no key) | gemini
SALESBOT_AI_PROVIDER=echo
# Free key: https://aistudio.google.com/apikey
SALESBOT_GEMINI_API_KEY=
# Comma-separated, tried in order when one is out of quota
SALESBOT_GEMINI_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Simulator: chat with the bot from the dashboard (dev only, needs SALESBOT_WA_SENDER=log)
SALESBOT_SIMULATOR_ENABLED=true

# Dashboard login
# Signs session tokens. Generate: openssl rand -hex 32
SALESBOT_JWT_SECRET=
SALESBOT_TOKEN_TTL=12h
# Development only: lets `npm run gen:api` read the API schema without logging in
SALESBOT_EXPOSE_API_DOCS=false
# First owner account (created once, when there are no users). Password: 10+ characters.
SALESBOT_ADMIN_EMAIL=
SALESBOT_ADMIN_NAME=
SALESBOT_ADMIN_PASSWORD=

# Frontend (server side only): where the Next.js server reaches the backend.
# The browser never calls the backend directly, so no CORS settings are needed.
SALESBOT_BACKEND_URL=http://localhost:8080
